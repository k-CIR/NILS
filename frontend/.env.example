# Frontend environment for the NATIVE (Docker-free) local dev setup.
# Vite auto-loads .env / .env.local from this directory (frontend/), so copy this
# file to frontend/.env.local and edit as needed, then run `npm run dev`.

VITE_API_URL=http://localhost:8010
VITE_DATA_ROOT=/absolute/path/to/your/dicom/data
VITE_USE_REAL_FILES=false
# APP_ACCESS_TOKEN=change_me_to_a_secure_token