# =============================================================================
# NILS — Optional environment overrides for `docker compose` / `scripts/manage.sh`
# =============================================================================
# This file is auto-loaded by `docker compose` when present as `.env` at the
# repo root, and is also sourced by `scripts/manage.sh`.  Most users do NOT
# need to set anything here — `scripts/manage.sh` already picks free ports and
# binds to localhost (127.0.0.1) by default.
#
# Uncomment and change a value below only when you need to override the
# built-in default (the value after `:-` in docker-compose.yml).
# =============================================================================

# --- Network / ports ---------------------------------------------------------
# BIND_ADDRESS=127.0.0.1       # Network interface to bind (0.0.0.0 for external access)
# DB_PORT=5432                  # Host port for the main PostgreSQL database
# BACKEND_PORT=8010             # Host port for the backend API
# METADATA_DB_PORT=5532         # Host port for the metadata PostgreSQL database
# BODY_PART_WORKER_PORT=8030    # Host port for the body-part QC worker API
# FRONTEND_PORT=5173            # Host port for the Vite dev server (frontend)

# --- Data paths --------------------------------------------------------------
# DB_DATA_DIR=./resource/db              # Host path for main DB data volume
# METADATA_DB_DATA_DIR=./resource/db_metadata  # Host path for metadata DB data volume
# BACKEND_DATA_ROOT=/app/data            # Container-internal data root for the backend
# FRONTEND_DATA_ROOT=/data               # Container-internal data root for the frontend

# --- Body-part QC worker -----------------------------------------------------
# BODY_PART_DEVICE=auto          # Device override: auto | cuda | cpu
# BODY_PART_BATCH=32             # Batch size for body-part QC inference

# --- Access control (frontend) -----------------------------------------------
# APP_ACCESS_TOKEN=              # Optional bearer token required by the frontend to
#                                 # access the API (empty = no token required)
# VITE_USE_REAL_FILES=false      # Expose real file system paths in the frontend
#                                 # (set to "true" when live data paths are mounted)

# =============================================================================
# For native (Docker-free) local dev, see backend/.env.example and
# frontend/.env.example instead, and use scripts/manage-native.sh.
# =============================================================================